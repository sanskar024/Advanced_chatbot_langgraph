# Google Gemini API key (for ChatGoogleGenerativeAI)
API_KEY=your_google_gemini_api_key

# Alpha Vantage API key (for the get_stock_price tool)
API_KEY_STOCKS=your_alphavantage_api_key

# PostgreSQL connection string used for LangGraph checkpoint memory.
# Set automatically by docker-compose; only needed for local (non-Docker) runs.
POSTGRES_URI=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Optional: used by docker-compose to configure the postgres service
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot

# Redis connection string, used for the semantic cache and rate limiter.
# Both features fail open (no-op) if Redis is unreachable, so this is
# optional for local dev but recommended for anything resembling production.
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=50
SEMANTIC_CACHE_TTL_SECONDS=21600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CALLS=10

# LangSmith tracing (optional). Leave LANGSMITH_API_KEY blank to disable
# tracing entirely -- nothing else about the app changes.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=advanced-rag-chatbot

# Self-correction / reflection loop: max revision passes per user turn.
MAX_SELF_CORRECTIONS=1
